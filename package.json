{
  "name": "lotus-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "node scripts/check-config.mjs && node scripts/render-meta.mjs && next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests admin-ui/src scripts/*.mjs",
    "format": "prettier --write src admin-ui/src tests *.json *.mjs *.yaml scripts/*.mjs",
    "format:check": "prettier --check src admin-ui/src tests *.json *.mjs *.yaml scripts/*.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "admin:dev": "pnpm --dir admin-ui dev",
    "admin:build": "pnpm --dir admin-ui build",
    "prepare:release": "python3 scripts/prepare.py",
    "preview": "python3 scripts/preview.py"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lenis": "^1.3.0",
    "@splinetool/runtime": "^1.12.0",
    "lucide-react": "^0.577.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "tailwindcss": "^4.2.0",
    "@tailwindcss/postcss": "^4.2.0",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.58.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.7.0",
    "@types/three": "^0.183.0"
  }
}
